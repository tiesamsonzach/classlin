{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "课堂通知",
  "version": "1.0.0",
  "identifier": "school.classroom.notify",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node serve.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "课堂通知",
        "url": "index.html",
        "width": 520,
        "height": 860,
        "minWidth": 420,
        "minHeight": 640,
        "visible": false,
        "focus": false,
        "resizable": true,
        "maximizable": true,
        "center": true
      },
      {
        "label": "popup",
        "title": "课堂通知",
        "url": "popup.html",
        "width": 1040,
        "height": 820,
        "minWidth": 640,
        "minHeight": 520,
        "visible": false,
        "focus": false,
        "resizable": true,
        "maximizable": true,
        "alwaysOnTop": true,
        "center": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
