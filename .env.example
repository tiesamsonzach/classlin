# 留空 = 只靠教室编号配对。公网请设一串口令（英文字母或数字，不要空格）。
TOKEN=

# 宿主机端口，映射到容器内 8080
PORT=8787

# 明文 HTTP 绑在哪张网卡。局域网试用用 0.0.0.0。
# 启用 HTTPS 时务必改成 127.0.0.1，避免 8787 对公网开放。
HTTP_BIND=0.0.0.0

# 启用 HTTPS 配置时使用：docker compose --profile https up -d
DOMAIN=notify.example.com

# 管理员账号。视频通话必须登录；教室电脑仍然只认教室编号，不登录。
# 多项用逗号分隔，密码里可以有冒号，不能有逗号。也可以改用下面的单个账号。
# ADMIN_USERS=teacher:change-me,office:another-secret
ADMIN_USERS=
ADMIN_USER=
ADMIN_PASSWORD=

# 哪个管理员可以呼叫哪些教室。不设置时，任何已登录管理员都可以呼叫任意教室。
# 多项用逗号分隔，一个管理员的多个教室用 | 分隔，* 表示全部教室。
# ADMIN_CLASSROOMS=teacher:7K3M-P9WQ|301,office:*
ADMIN_CLASSROOMS=

# 登录会话签名密钥。留空时服务器会在数据目录生成 admin-session.key。至少 16 位。
ADMIN_SESSION_SECRET=

# WebRTC。默认只有公共 STUN。校园网或校外互通时再填 TURN（coturn）。
# STUN_URLS 用逗号分隔。TURN_URLS 只能是 turn: 或 turns:。
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# 二选一：短期凭证（coturn 的 use-auth-secret / static-auth-secret），或固定账号。
# 设了 TURN_SECRET 时忽略 TURN_USERNAME / TURN_PASSWORD。
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=
# 短期凭证有效秒数，60 到 86400，默认 3600。
TURN_TTL_SECONDS=3600
# 只给可选的 coturn 容器用，不参与网页服务器。
TURN_REALM=notify.example.com
